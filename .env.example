# NameInsight configuration. Copy to .env (gitignored) and fill in values as needed.
# All settings are optional; defaults are shown. NEVER commit real values for secrets.
#
# Load it with: node --env-file=.env ./dist/app/index.js

# Loopback by default; use 0.0.0.0 to serve other machines (e.g. in a container).
API_HOST=127.0.0.1
API_PORT=8080
APP_NAME=NameInsight
LOG_REQUESTS=true
SHUTDOWN_TIMEOUT_MS=10000

# Comma-separated origins allowed to call the API from a browser (empty = none)
CORS_ORIGINS=
# Reverse proxies in front of the service (for correct client IPs in rate limiting)
TRUST_PROXY_HOPS=0

RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
LOOKUP_BUDGET_MAX=200
LOOKUP_BUDGET_WINDOW_MS=60000
MAX_DOMAINS_PER_REQUEST=50
LOOKUP_CONCURRENCY=5
MAX_CONCURRENT_LOOKUPS=20
MAX_BODY_BYTES=16384
MAX_UPLOAD_BYTES=65536

# Comma-separated DNS server IPs (empty = system resolvers)
DNS_SERVERS=
DNS_TIMEOUT_MS=5000
PING_TIMEOUT_SECONDS=2
WHOIS_TIMEOUT_MS=10000
MAX_WHOIS_RESPONSE_BYTES=131072
RDAP_TIMEOUT_MS=5000
MAX_RDAP_RESPONSE_BYTES=262144
WEB_CHECK_TIMEOUT_MS=5000

# AI suggestions. ANTHROPIC_API_KEY is a SECRET: set it only here in your untracked .env or in your
# deployment's secret store. NEVER commit a real value. Leave empty to disable REST suggestions (503).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
SUGGEST_RATE_LIMIT_MAX=5
