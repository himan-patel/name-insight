{
  "name": "nameinsight",
  "version": "1.0.1",
  "description": "NameInsight: look up domain names and estimate whether they are available to register",
  "main": "dist/app/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint app test",
    "typecheck": "tsc --noEmit -p .",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && npm run start:dist",
    "start:dist": "node ./dist/app/index.js",
    "start:tsnode": "ts-node ./app/index.ts",
    "start-watch:tsnode": "node --watch --require ts-node/register ./app/index.ts",
    "inspect:tsnode": "node --inspect --require ts-node/register ./app/index.ts",
    "prepare": "husky"
  },
  "author": "Himan Patel",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "ping": "0.3.0",
    "swagger-ui-express": "5.0.1",
    "whois": "2.16.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "secretlint": "13.0.7",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
