{
  "name": "nameinsight",
  "version": "1.0.1",
  "description": "AI-powered domain name discovery: availability across TLDs, registry insights (RDAP/WHOIS, DNS, expiry, parking) via MCP server or REST API",
  "keywords": [
    "domain",
    "domain-availability",
    "rdap",
    "whois",
    "dns",
    "mcp",
    "mcp-server",
    "ai",
    "domain-names"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himan-patel/name-insight.git"
  },
  "homepage": "https://github.com/himan-patel/name-insight#readme",
  "main": "dist/app/index.js",
  "bin": {
    "nameinsight-mcp": "dist/app/mcp/stdio.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint app test",
    "typecheck": "tsc --noEmit -p .",
    "secrets": "secretlint --maskSecrets \"**/*\"",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "npm run build && npm run start:dist",
    "start:dist": "node ./dist/app/index.js",
    "start:mcp": "node ./dist/app/mcp/stdio.js",
    "start:tsnode": "ts-node ./app/index.ts",
    "mcp:tsnode": "ts-node ./app/mcp/stdio.ts",
    "start-watch:tsnode": "node --watch --require ts-node/register ./app/index.ts",
    "inspect:tsnode": "node --inspect --require ts-node/register ./app/index.ts",
    "prepare": "husky",
    "deps:age": "node scripts/check-dependency-age.mjs"
  },
  "author": "Himan Patel",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@modelcontextprotocol/sdk": "1.32.0",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "ping": "0.4.4",
    "swagger-ui-express": "5.0.1",
    "tldts": "7.4.18",
    "whois": "2.16.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jest": "30.0.0",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "secretlint": "13.0.7",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    },
    "tldts-core": "7.4.16",
    "express@5.3.0": "5.2.1",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.12",
    "qs": "6.16.0",
    "swagger-ui-dist": "5.33.1",
    "openapi3-ts": "4.6.1",
    "ip-address": "10.7.3",
    "@babel/runtime": "7.29.7"
  }
}
